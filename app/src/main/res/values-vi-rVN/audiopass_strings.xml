    <string name="audiopass_hires">Đầu ra Hi-res (32-bit)</string>
    <string name="audiopass_exclusive">Chế độ độc quyền (Exclusive)</string>
    <string name="audiopass_resampler">Bộ lấy mẫu lại Hi-Fi của Mochy</string>
    <string name="audiopass_resampler_desc">Chỉ áp dụng cho loa ngoài và cổng tai nghe. Bài hát được đưa về tần số chuẩn của máy bằng bộ lọc sạch hơn mặc định của Android.</string>
    <string name="audiopass_passthrough">Truyền thẳng Bit-perfect</string>
    <string name="audiopass_passthrough_desc">Bài hát được truyền nguyên bản tới DAC mà không bị Android trộn âm hay lấy mẫu lại.</string>
    <string name="audiopass_modes">Chế độ</string>
    <string name="audiopass_mode_song_rate">Theo tần số bài hát</string>
    <string name="audiopass_mode_song_rate_desc">Android chạy DAC theo đúng tần số mẫu của từng bài hát. Các hiệu ứng âm thanh vẫn hoạt động.</string>
    <string name="audiopass_mode_bit_perfect">Bit-perfect</string>
    <string name="audiopass_mode_bit_perfect_desc">Android chuyển mọi bài nhạc lossless tới DAC nguyên vẹn không chỉnh sửa.</string>
    <string name="audiopass_mode_direct_usb">USB Trực tiếp (Direct USB)</string>
    <string name="audiopass_mode_direct_usb_desc">Mochy tự điều khiển trực tiếp DAC trên mọi bản Android và chỉnh âm lượng ngay trên DAC. Sẽ hỏi quyền truy cập USB.</string>
    <string name="audiopass_mode_exclusive_usb">USB Độc quyền (Exclusive USB)</string>
    <string name="audiopass_mode_exclusive_usb_desc">Mở DAC dành riêng cho Mochy ở đúng tần số bài hát. Không phải điện thoại nào cũng hỗ trợ.</string>
    <string name="audiopass_mode_exclusive_dac">DAC tích hợp</string>
    <string name="audiopass_mode_exclusive_dac_desc">Dành cho máy nghe nhạc có DAC riêng: cổng tai nghe được mở độc quyền cho Mochy.</string>
    <string name="audiopass_mode_needs">Cần Android %1$s</string>

