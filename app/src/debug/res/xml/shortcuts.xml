<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.mochyy.mochymusic.action.SEARCH"
            android:targetClass="com.mochyy.mochymusic.MainActivity"
            android:targetPackage="com.mochyy.mochymusic.debug" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_library"
        android:shortcutId="library"
        android:shortcutShortLabel="@string/filter_library">
        <intent
            android:action="com.mochyy.mochymusic.action.LIBRARY"
            android:targetClass="com.mochyy.mochymusic.MainActivity"
            android:targetPackage="com.mochyy.mochymusic.debug" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/mic"
        android:shortcutId="recognize"
        android:shortcutShortLabel="@string/shortcut_recognize">
        <intent
            android:action="com.mochyy.mochymusic.action.RECOGNIZE"
            android:targetClass="com.mochyy.mochymusic.MainActivity"
            android:targetPackage="com.mochyy.mochymusic.debug" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/favorite"
        android:shortcutId="liked"
        android:shortcutShortLabel="@string/shortcut_liked">
        <intent
            android:action="com.mochyy.mochymusic.action.LIKED"
            android:targetClass="com.mochyy.mochymusic.MainActivity"
            android:targetPackage="com.mochyy.mochymusic.debug" />
    </shortcut>
</shortcuts>
